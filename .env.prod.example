# Domain where the app will be served (full stack) (e.g. myntra.example.com)
DOMAIN=myntra.example.com

# Domain for the backend API when using Vercel for the frontend (e.g. api.myntra.example.com)
API_DOMAIN=api.myntra.example.com

# Comma-separated list of allowed CORS origins for the API Gateway (e.g. https://myntra.example.com,https://myntra-dashboard.vercel.app)
CORS_ORIGINS=*

# Database credentials - change these to strong random values before deploying
POSTGRES_USER=myntra_user
POSTGRES_PASSWORD=change-me-to-a-strong-password

MONGODB_USER=myntra_user
MONGODB_PASSWORD=change-me-to-a-strong-password

# API authentication
JWT_SECRET=change-me-to-a-long-random-string

# External API keys
YOUTUBE_API_KEY=your-youtube-api-key

# Deployment helpers
COMPOSE_PROJECT_NAME=myntra-dashboard-prod
