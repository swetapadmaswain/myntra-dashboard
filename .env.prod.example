# Domain where the app will be served (full stack) (e.g. myntra.example.com)
DOMAIN=myntra.example.com

# Domain for the backend API when using Vercel for the frontend (e.g. api.myntra.example.com)
API_DOMAIN=api.myntra.example.com

# Comma-separated list of allowed CORS origins for the API Gateway (e.g. https://myntra.example.com,https://myntra-dashboard.vercel.app)
CORS_ORIGINS=*

# PostgreSQL (Supabase) connection
POSTGRES_HOST=db.<id>.supabase.co
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-to-a-strong-password
POSTGRES_SSLMODE=require

# MongoDB (managed or self-hosted) connection
MONGODB_HOST=mongodb.example.com
MONGODB_PORT=27017
MONGODB_DB=myntra_dashboard
MONGODB_USER=myntra_user
MONGODB_PASSWORD=change-me-to-a-strong-password

# Redis (managed or self-hosted) connection
REDIS_HOST=redis.example.com
REDIS_PORT=6379
REDIS_PASSWORD=change-me-to-a-strong-password

# API authentication
JWT_SECRET=change-me-to-a-long-random-string

# External API keys
YOUTUBE_API_KEY=your-youtube-api-key

# Deployment helpers
COMPOSE_PROJECT_NAME=myntra-dashboard-prod
