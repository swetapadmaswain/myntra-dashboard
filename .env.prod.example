# Domain for the backend API
# Using nip.io for free SSL with your VPS IP (e.g. 132.226.186.155.nip.io)
# This gives you https://132.226.186.155.nip.io → your VPS
API_DOMAIN=132.226.186.155.nip.io

# Comma-separated list of allowed CORS origins
# Add your Vercel frontend URL here after deploying
CORS_ORIGINS=*

# PostgreSQL (self-hosted in Docker)
POSTGRES_DB=myntra_dashboard
POSTGRES_USER=myntra_user
POSTGRES_PASSWORD=myntra_secure_password_2024

# MongoDB (self-hosted in Docker)
MONGODB_DB=myntra_dashboard
MONGODB_USER=myntra_user
MONGODB_PASSWORD=myntra_secure_password_2024

# Redis (self-hosted in Docker, no password needed for local)
REDIS_PASSWORD=

# API authentication (internal service-to-service, not for end users)
JWT_SECRET=change-me-to-a-long-random-string-use-openssl-rand-hex-32

# External API keys
YOUTUBE_API_KEY=your-youtube-api-key

# Deployment helpers
COMPOSE_PROJECT_NAME=myntra-dashboard-prod
