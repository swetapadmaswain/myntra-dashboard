# Database Configuration
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=myntra_dashboard
POSTGRES_USER=myntra_user
POSTGRES_PASSWORD=myntra_password

MONGODB_HOST=mongodb
MONGODB_PORT=27017
MONGODB_USER=myntra_user
MONGODB_PASSWORD=myntra_password
MONGODB_DB=myntra_dashboard

REDIS_HOST=redis
REDIS_PORT=6379

ELASTICSEARCH_HOST=elasticsearch
ELASTICSEARCH_PORT=9200

# API Gateway Configuration
NODE_ENV=development
PORT=3000
JWT_SECRET=your-jwt-secret-key-change-in-production

# Service URLs
NLP_SERVICE_URL=http://nlp-service:8000
ANALYTICS_SERVICE_URL=http://analytics-service:8001
DATA_INGESTION_URL=http://data-ingestion:8002

# External API Keys
REDDIT_CLIENT_ID=your-reddit-client-id
REDDIT_CLIENT_SECRET=your-reddit-client-secret
YOUTUBE_API_KEY=your-youtube-api-key

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:3000
NEXT_PUBLIC_ENABLE_ANALYTICS=true

# Celery Configuration
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Monitoring & Logging
LOG_LEVEL=info
ENABLE_METRICS=true
